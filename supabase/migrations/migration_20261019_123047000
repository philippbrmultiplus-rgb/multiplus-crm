-- cadência: liga a linha da planilha ao cliente novo e incorpora a data de 15/10
with alvo as (
  select array(
           select distinct unnest(coalesce(datas, '{}'::date[]) || array['2026-10-15']::date[]) order by 1
         ) as datas
  from public.client_cadence
  where nome_planilha = 'TREND INCORPORADORA -'
),
calc as (
  select a.datas,
         array_length(a.datas, 1) as coletas,
         a.datas[array_length(a.datas, 1)] as ultima,
         (select round(avg(diff), 1) from (
            select (a.datas[idx + 1] - a.datas[idx]) as diff
            from generate_subscripts(a.datas, 1) as gs(idx)
            where idx < array_length(a.datas, 1)
         ) x) as media
  from alvo a
)
update public.client_cadence c
set client_id = 'cli-entrada-46',
    datas = calc.datas,
    coletas = coalesce(calc.coletas, 0),
    ultima_coleta = calc.ultima,
    media_dias = calc.media,
    atualizado_em = now()
from calc
where c.nome_planilha = 'TREND INCORPORADORA -';