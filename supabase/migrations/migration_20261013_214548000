limpo as (
  select nome, media_dias, coletas, ultima,
         upper(regexp_replace(regexp_replace(translate(regexp_replace(nome, ' *[-–].*$', ''), 'áàãâäéèêëíìîïóòõôöúùûüçÁÀÃÂÄÉÈÊËÍÌÎÏÓÒÕÔÖÚÙÛÜÇ', 'aaaaaeeeeiiiiooooouuuucAAAAAEEEEIIIIOOOOOUUUUC'), '^[^A-Za-z0-9]+', ''), '\s+', ' ', 'g')) as chave
  from origem
), clientes as (
  select id,
         upper(regexp_replace(regexp_replace(translate(regexp_replace(name, ' *[-–].*$', ''), 'áàãâäéèêëíìîïóòõôöúùûüçÁÀÃÂÄÉÈÊËÍÌÎÏÓÒÕÔÖÚÙÛÜÇ', 'aaaaaeeeeiiiiooooouuuucAAAAAEEEEIIIIOOOOOUUUUC'), '^[^A-Za-z0-9]+', ''), '\s+', ' ', 'g')) as chave
  from public.clients
)
insert into public.client_cadence (client_id, nome_planilha, media_dias, coletas, ultima_coleta)
select m.client_id, l.nome, l.media_dias, l.coletas, l.ultima
from limpo l
left join lateral (
  select c.id as client_id
  from clientes c
  where c.chave = l.chave or c.chave like l.chave || '%' or l.chave like c.chave || '%'
  order by (c.chave = l.chave) desc, length(c.chave) desc, c.id
  limit 1
) m on true
on conflict (nome_planilha) do update
  set client_id = excluded.client_id, media_dias = excluded.media_dias, coletas = excluded.coletas, ultima_coleta = excluded.ultima_coleta, atualizado_em = now();

