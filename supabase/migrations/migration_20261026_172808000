with unido as (
  select cc.client_id,
         array(
           select distinct unnest(coalesce(cc.datas, '{}'::date[]) || coalesce(co.datas, '{}'::date[])) order by 1
         ) as datas
  from public.client_cadence cc
  left join (
    select client_id, array_agg(distinct collect_date) as datas
    from public.coletas
    where collect_date >= '2026-10-01'
    group by client_id
  ) co on co.client_id = cc.client_id
),
calc as (
  select u.client_id, u.datas,
         array_length(u.datas, 1) as coletas,
         u.datas[array_length(u.datas, 1)] as ultima,
         (select round(avg(diff), 1) from (
            select (u.datas[idx + 1] - u.datas[idx]) as diff
            from generate_subscripts(u.datas, 1) as gs(idx)
            where idx < array_length(u.datas, 1)
         ) x) as media
  from unido u
)
update public.client_cadence c
set datas = calc.datas,
    coletas = coalesce(calc.coletas, 0),
    ultima_coleta = calc.ultima,
    media_dias = calc.media,
    atualizado_em = now()
from calc
where c.client_id = calc.client_id;