-- 2) comparativo mensal: outubro recalculado a partir do histórico de coletas do mês
insert into public.client_monthly_volumes (client_id, month, volume_m3)
select client_id, date '2026-10-01', sum(volume_m3)
from public.coletas
where collect_date >= '2026-10-01' and collect_date < '2026-11-01'
group by client_id
on conflict (client_id, month) do update set volume_m3 = excluded.volume_m3;

-- 3) data da última coleta (só avança)
with ultimas as (
  select c.id, max(co.collect_date) as ultima
  from public.clients c
  join public.coletas co on co.client_id = c.id and co.collect_date >= '2026-10-01'
  group by c.id
)
update public.clients c
set last_collect_at = u.ultima,
    updated_at = now()
from ultimas u
where c.id = u.id
  and (c.last_collect_at is null or c.last_collect_at < u.ultima);

-- 4) cadência de troca: incorpora as datas do histórico e recalcula
with unido as (
  select cc.client_id,
         array(
           select distinct unnest(coalesce(cc.datas, '{}'::date[]) || coalesce(co.datas, '{}'::date[])) order by 1
         ) as datas
  from public.client_cadence cc
  left join (
    select client_id, array_agg(distinct collect_date) as datas
    from public.coletas
    where collect_date >= '2026-10-01'
    group by client_id
  ) co on co.client_id = cc.client_id
),
calc as (
  select u.client_id, u.datas,
         array_length(u.datas, 1) as coletas,
         u.datas[array_length(u.datas, 1)] as ultima,
         (select round(avg(diff), 1) from (
            select (u.datas[idx + 1] - u.datas[idx]) as diff
            from generate_subscripts(u.datas, 1) as gs(idx)
            where idx < array_length(u.datas, 1)
         ) x) as media
  from unido u
)
update public.client_cadence c
set datas = calc.datas,
    coletas = coalesce(calc.coletas, 0),
    ultima_coleta = calc.ultima,
    media_dias = calc.media,
    atualizado_em = now()
from calc
where c.client_id = calc.client_id;